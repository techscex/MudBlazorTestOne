@using System.Globalization
@namespace MudSliderHybridRepro.Components.Owned

<div class="app-color-slider" style="--app-color-track:@Track">
    <label for="@id">@Label <span>@ValueText</span></label>
    <input id="@id" type="range" min="@Number(Min)" max="@Number(Max)" step="@Number(Step)"
           value="@Number(Value)" @oninput="Input" disabled="@Disabled" aria-label="@Label"
           aria-valuetext="@ValueText" />
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public double Value { get; set; }
    [Parameter] public EventCallback<double> ValueChanged { get; set; }
    [Parameter] public double Min { get; set; }
    [Parameter] public double Max { get; set; } = 100;
    [Parameter] public double Step { get; set; } = 1;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? ValueText { get; set; }
    [Parameter] public string Track { get; set; } = "var(--mud-palette-primary)";
    private readonly string id = "app-color-slider-" + Guid.NewGuid().ToString("N");
    private static string Number(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
    internal Task Input(ChangeEventArgs args)
    {
        if (Disabled || !double.TryParse(args.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var value)
            || !double.IsFinite(value)) return Task.CompletedTask;
        value = Math.Clamp(value, Min, Math.Max(Min, Max));
        return value == Value ? Task.CompletedTask : ValueChanged.InvokeAsync(value);
    }
}
